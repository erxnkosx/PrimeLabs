# Kopieer naar .env.local (lokaal) of zet deze waarden in Vercel → Settings → Environment Variables.

# Productie-URL zonder slash op het einde. Wordt gebruikt voor canonical URL's,
# Open Graph, sitemap.xml, robots.txt en structured data.
NEXT_PUBLIC_SITE_URL=https://primelabs.be

# Optioneel: verificatiecodes van Google Search Console en Bing Webmaster Tools
# (alleen de code, niet de volledige meta-tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 — meet-ID (G-XXXXXXXXXX). Leeg = geen analytics en geen cookiebanner.
# GA laadt pas na toestemming via de cookiebanner.
NEXT_PUBLIC_GA_ID=

# ---- Offerteformulier (Cloudflare Pages Function functions/api/offerte.ts) ----
# Deze staan NIET in .env maar in Cloudflare → project → Settings → Variables and Secrets.
# RESEND_API_KEY=re_xxxxxxxx            (type: Secret)
# RESEND_FROM=Primelabs <offerte@primelabs.be>
# OFFERTE_TO=info@primelabs.be
# OFFERTE_BEVESTIGING=true              (optioneel: ontvangstbevestiging naar de aanvrager)
