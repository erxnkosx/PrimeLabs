# Kopieer naar .env.local (lokaal) of zet deze waarden in Vercel → Settings → Environment Variables.

# Productie-URL zonder slash op het einde. Wordt gebruikt voor canonical URL's,
# Open Graph, sitemap.xml, robots.txt en structured data.
NEXT_PUBLIC_SITE_URL=https://primelabs.be

# Optioneel: verificatiecodes van Google Search Console en Bing Webmaster Tools
# (alleen de code, niet de volledige meta-tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
